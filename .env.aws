# AWS EC2 template -- fill in before deploying
IMAGE=ghcr.io/YOUR_ORG/tabular-analytics:FILL_GIT_SHA
IMAGE_TAG=FILL_GIT_SHA
DOMAIN=environment
PROVIDER=mock
HOSTED_API_KEY=sk-FILL_IF_USING_OPENAI
DATA_ROOT=/opt/tabular-analytics/data
DATA_VOLUME=/opt/tabular-analytics/data
HTTP_PORT=80
HTTPS_PORT=443
GRAFANA_PORT=3000
GRAFANA_PASSWORD=CHANGE_THIS_IN_PROD
LOG_LEVEL=INFO
CACHE_TTL=3600
